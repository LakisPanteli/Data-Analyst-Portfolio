#boosting
set.seed(10)
lambda <- 10^seq(from=-5,to=-0.5,by=0.05) # shrinkage parameter
train.error <- rep(-1, length(lambda))

for (i in 1:length(lambda)) {
  boosting.bike <- gbm(cnt ~ . -dteday -instant -casual -registered, data = bike.train, distribution = "gaussian", n.trees = 1000, shrinkage = lambda[i])
  pred.bike.train <- predict(boosting.bike, bike.train, n.trees = 1000)
  train.error[i] <- mean((pred.bike.train - bike.train$cnt)^2)
}
plot(lambda, train.error, type = "b", xlab = "Lambda", ylab = "Training MSE")

#test error
set.seed(10)
test.error <- rep(-1, length(lambda))

for (i in 1:length(lambda)) {
  boosting.bike <- gbm(cnt ~ . -dteday -instant -casual -registered, data = bike.train, distribution = "gaussian", n.trees = 1000, shrinkage = lambda[i])
  pred.bike.test <- predict(boosting.bike, bike.test, n.trees = 1000)
  test.error[i] <- mean((pred.bike.test - bike.test$cnt)^2)
}

plot(lambda, test.error, type = "b", xlab = "Lambda", ylab = "Test MSE")
bestlam.boosting <- lambda[which.min(test.error)] # shrinkage parameter - lambda - corresponding to the minimum
bestlam.boosting
min(test.error) # minimum test MSE 

mse.boosting <- min(test.error) #test MSE
#most important variables
boosting.hitters <- gbm(cnt ~ . -dteday -instant -casual  -registered, data = bikerental, distribution = "gaussian", n.trees = 1000, shrinkage = bestlam.boosting)
summary(boosting.hitters)



