#ridge regression
set.seed(10)
train.X <- model.matrix(cnt ~ . -dteday -casual -registered -instant, data=bike.train)[,-1]
test.X <- model.matrix(cnt ~. -dteday -casual -registered -instant, data=bike.test)[,-1]
grid <- 10^seq(5,-3, length=100)
ridge.mod <- glmnet(train.X, bike.train$cnt, alpha = 0, lambda=grid)
ridge.cv <- cv.glmnet(train.X, bike.train$cnt, alpha = 0, lambda=grid)

plot(ridge.cv)

#best lambda value
ridge.bestlam <- ridge.cv$lambda.min
ridge.bestlam
ridge.pred <- predict(ridge.mod, s=ridge.bestlam, newx=test.X)
mean((ridge.pred - bike.test$cnt)^2)   #test MSE

# within 1 se
ridge.1se <- ridge.cv$lambda.1se
ridge.1se
ridge.pred2 <- predict(ridge.mod, s = ridge.1se, newx = test.X)
mean((ridge.pred2 - bike.test$cnt)^2)   

mse.ridge <- mean((ridge.pred - bike.test$cnt)^2)   #test MSE
mse.ridge

